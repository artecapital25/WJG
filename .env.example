# ==============================================================================
# WJGEEKS 3D PRO - PLANTILLA DE VARIABLES DE ENTORNO SEGURAS (.env.example)
# ==============================================================================
# Copia este archivo a .env.local o .env para desarrollo local o configúralo en Vercel/Supabase.
# NUNCA subas archivos .env con credenciales reales al repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Supabase (Cliente Público / Frontend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-publica-aqui

# Compatibilidad Next.js / Vercel (opcional)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-publica-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# ------------------------------------------------------------------------------
# 2. Credenciales del Servidor / Backend (¡PROHIBIDO EXPONER EN CLIENTE!)
# Únicamente utilizadas por Supabase Edge Functions, scripts DBA y jobs desatendidos
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-aqui

# ------------------------------------------------------------------------------
# 3. WhatsApp Business Cloud API (Automatización 100% Desatendida)
# Credenciales de Meta Developer Portal para envío desatendido sin interacción humana
# ------------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=EAAG...tu_meta_user_or_system_token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_aleatorio_seguro_para_webhook

# Endpoint de Edge Function o Webhook de Despacho
VITE_WHATSAPP_API_URL=https://tu-proyecto.supabase.co/functions/v1/dispatch-whatsapp-notifications

# ------------------------------------------------------------------------------
# 4. URLs y Parámetros Operativos
# ------------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173

# PINs de Emergencia de Taller (Opcional: separados por coma; si se omiten, usa verificación por hash SHA-256)
# VITE_STAFF_EMERGENCY_PINS=pin1,pin2
